{"nodes": [{"id": "_claude_skills_graphify_skill_pipeline", "label": "Graphify Full Pipeline", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_fast_path", "label": "Graphify Query Fast Path", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If graphify-out/graph.json already exists and the request is a natural-language question rather than an explicit rebuild command, skip Steps 1-5 entirely and jump straight to query - the graph is already built."}, {"id": "_claude_skills_graphify_skill_ast_semantic_split", "label": "AST vs Semantic Extraction Split", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code is extracted structurally via AST with no LLM or API key needed; semantic extraction for docs/papers/images uses Gemini only if a key is already set, otherwise the host agent itself is the LLM. graphify never reads ANTHROPIC_API_KEY or OPENAI_API_KEY, so a code-only corpus skips semantic extraction entirely and needs no key."}, {"id": "_claude_skills_graphify_skill_extraction_cache", "label": "Semantic Extraction Cache (Step B0)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cache entries are keyed to the extraction prompt file (SPEC_PATH) so a prompt upgrade re-extracts affected files instead of replaying stale results, while unchanged prompts keep their cached entries (#1939)."}, {"id": "_claude_skills_graphify_skill_subagent_dispatch", "label": "Parallel Subagent Dispatch (Steps B1-B3)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All chunk subagents must be dispatched in a single message with subagent_type=general-purpose, never Explore (which is read-only and cannot write chunk files, silently dropping results); real token counts are read from the Agent tool's usage field and patched into each chunk JSON before merging since the chunk JSON's own token fields are placeholder zeros."}, {"id": "_claude_skills_graphify_skill_shrink_guard", "label": "Graph Shrink Guard (#479)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "to_json() refuses to write a new graph.json that is smaller than the existing one, so an empty or bad extraction can't silently clobber a good graph; overriding an intentional shrink requires --force."}, {"id": "_claude_skills_graphify_skill_health_check", "label": "Graph Health Check (Step 4.5)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_manifest_stamping", "label": "Manifest Stamping Rule (#2015/#1948)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only semantic files that actually produced output this run get stamped in the manifest; a changed file whose chunk failed or was omitted must stay unstamped, or have its stale semantic_hash cleared, so the next --update re-queues it instead of losing its content forever."}, {"id": "_claude_skills_graphify_skill_honesty_rules", "label": "Graphify Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge (use AMBIGUOUS instead), never skip the corpus-size warning, always show token cost, never hide cohesion scores behind symbols, never run HTML viz above 5000 nodes without warning."}, {"id": "_claude_skills_graphify_skill_guide_step", "label": "Post-Pipeline Guide Behavior", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After the pipeline finishes, pick the single most interesting suggested question - the one crossing the most community boundaries - and offer to trace it; the graph is the map, and the skill's job afterward is to be the guide, ending each answer with a follow-up so exploration continues."}], "edges": [{"source": "_claude_skills_graphify_skill_pipeline", "target": "_claude_skills_graphify_references_add_watch_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_pipeline", "target": "_claude_skills_graphify_references_github_and_merge_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_pipeline", "target": "_claude_skills_graphify_references_transcribe_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_pipeline", "target": "_claude_skills_graphify_references_extraction_spec_subagent_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_pipeline", "target": "_claude_skills_graphify_references_exports_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_pipeline", "target": "_claude_skills_graphify_references_update_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_pipeline", "target": "_claude_skills_graphify_references_query_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_pipeline", "target": "_claude_skills_graphify_references_hooks_overview", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_extraction_cache", "target": "_claude_skills_graphify_references_extraction_spec_subagent_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_subagent_dispatch", "target": "_claude_skills_graphify_references_extraction_spec_subagent_prompt", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_graphify_skill_shrink_guard", "target": "_claude_skills_graphify_references_update_build_merge", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "graphify_conditional_reference_docs", "label": "Graphify Conditional Reference-Doc Architecture", "nodes": ["_claude_skills_graphify_skill_pipeline", "_claude_skills_graphify_references_add_watch_overview", "_claude_skills_graphify_references_github_and_merge_overview", "_claude_skills_graphify_references_update_overview", "_claude_skills_graphify_references_query_overview", "_claude_skills_graphify_references_hooks_overview", "_claude_skills_graphify_references_exports_overview", "_claude_skills_graphify_references_transcribe_overview", "_claude_skills_graphify_references_extraction_spec_subagent_prompt"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/graphify/SKILL.md"}, {"id": "graph_integrity_safeguards", "label": "Graph Integrity Safeguards Across the Pipeline", "nodes": ["_claude_skills_graphify_skill_shrink_guard", "_claude_skills_graphify_skill_manifest_stamping", "_claude_skills_graphify_references_update_build_merge", "_claude_skills_graphify_references_update_cluster_only"], "relation": "implement", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": ".claude/skills/graphify/SKILL.md"}]}