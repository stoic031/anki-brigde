{"nodes": [{"id": "_claude_rules_ui_copy_copy_style", "label": "Copy Style Rules", "file_type": "rationale", "source_file": ".claude/rules/ui-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All user-facing strings in English for the Obsidian community store; sentence case; bold for literal UI labels; arrow notation for navigation; reuse the existing emoji set instead of inventing icons; failure copy states what happened and what to do next."}, {"id": "_claude_rules_ui_copy_button_state_cycle", "label": "Button State Cycle", "file_type": "concept", "source_file": ".claude/rules/ui-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_rules_ui_copy_long_operation_feedback", "label": "Long Operation Feedback", "file_type": "rationale", "source_file": ".claude/rules/ui-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "AI calls take 5-30s; a persistent Notice that updates as work progresses, replaced by a success toast, is required - a static Processing... with no updates is a bug."}, {"id": "_claude_rules_ui_copy_styling_rule", "label": "Themed Styling Rule", "file_type": "rationale", "source_file": ".claude/rules/ui-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Use Obsidian CSS variables, never hardcoded hex, so the plugin looks correct in light/dark/community themes; prefix CSS classes to avoid collisions with other plugins."}, {"id": "_claude_rules_ui_copy_shared_settings_state", "label": "Shared Settings State Rule", "file_type": "rationale", "source_file": ".claude/rules/ui-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Settings tab and sidebar view must read and write the same this.settings object and both re-render on change; two copies drifting apart is called out as the single most likely bug in this area."}, {"id": "_claude_rules_ui_copy_listener_cleanup", "label": "Listener Cleanup Rule", "file_type": "rationale", "source_file": ".claude/rules/ui-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every listener from a view or modal uses registerDomEvent/registerEvent/registerInterval, or is torn down in onClose; detached listeners survive plugin reload and cause duplicate handlers."}, {"id": "docs_design_05_ui_spec", "label": "docs/design/05-ui.md", "file_type": "document", "source_file": ".claude/rules/ui-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_06_settings_spec", "label": "docs/design/06-settings.md", "file_type": "document", "source_file": ".claude/rules/ui-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_design_07_sidebar_spec", "label": "docs/design/07-sidebar.md", "file_type": "document", "source_file": ".claude/rules/ui-copy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_rules_ui_copy_button_state_cycle", "target": "docs_design_03_note_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/ui-copy.md", "source_location": null, "weight": 1.0}, {"source": "_claude_rules_ui_copy_copy_style", "target": "docs_design_05_ui_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/rules/ui-copy.md", "source_location": null, "weight": 1.0}, {"source": "_claude_rules_ui_copy_copy_style", "target": "docs_design_06_settings_spec", "relation": "references", "confidence": "EXTRACTED", "confidence_s